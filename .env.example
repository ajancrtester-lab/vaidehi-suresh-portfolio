# Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============== Backend Configuration ==============

# MongoDB Connection (Use MongoDB Atlas Free Tier)
# Get from: https://www.mongodb.com/cloud/atlas/register
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=portfolio_db

# Admin Credentials
ADMIN_PASSWORD=your_secure_admin_password_here

# WhatsApp Configuration
ARTIST_WHATSAPP=+919446909402

# Backend URL (Set after Railway deployment)
# Format: https://your-app-name.railway.app
BACKEND_URL=https://your-railway-app.railway.app

# CORS Origins (Your Netlify frontend URL)
CORS_ORIGINS=https://your-netlify-site.netlify.app,http://localhost:3000


# ============== Frontend Configuration ==============
# (Set in Netlify environment variables)

# Backend API URL (Your Railway backend URL)
REACT_APP_BACKEND_URL=https://your-railway-app.railway.app
